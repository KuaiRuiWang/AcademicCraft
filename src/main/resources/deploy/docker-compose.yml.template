services:
  app:
    build: .
    container_name: __APP_CONTAINER_NAME__
    restart: unless-stopped
    ports:
      - "__HOST_PORT__:3000"
    environment:
      NODE_ENV: production
      DB_HOST: mysql
      DB_PORT: 3306
      DB_NAME: app_db
      DB_USER: appuser
      DB_PASSWORD: ${DB_PASSWORD}
    depends_on:
      mysql:
        condition: service_healthy
    networks: [app_net]
    deploy:
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
          pids: 100
    cap_drop: [ALL]
    security_opt:
      - "no-new-privileges:true"
    read_only: true
    tmpfs:
      - /tmp
    volumes:
      - app_logs:/app/logs

  mysql:
    image: mysql:8.0
    container_name: __MYSQL_CONTAINER_NAME__
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: app_db
      MYSQL_USER: appuser
      MYSQL_PASSWORD: ${DB_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    networks: [app_net]
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      retries: 10
    deploy:
      resources:
        limits:
          cpus: '0.3'
          memory: 256M
    volumes:
      - mysql_data:/var/lib/mysql

networks:
  app_net:
    driver: bridge

volumes:
  app_logs:
  mysql_data:
